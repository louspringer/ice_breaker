@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix conversation: <./conversation#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

conversation:ConversationOntology rdf:type owl:Ontology ;
    dc:title "Conversation Ontology" ;
    dc:version "1.0" .

# Core Classes
conversation:Conversation rdf:type owl:Class ;
    rdfs:label "Conversation" ;
    rdfs:comment "A class representing a conversation." .

conversation:Message rdf:type owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A class representing a message in the conversation." .

conversation:hasMessage rdf:type owl:ObjectProperty ;
    rdfs:label "has message" ;
    rdfs:domain conversation:Conversation ;
    rdfs:range conversation:Message ;
    rdfs:comment "Relates a conversation to its messages." .

conversation:content rdf:type owl:DatatypeProperty ;
    rdfs:label "content" ;
    rdfs:domain conversation:Message ;
    rdfs:range xsd:string ;
    rdfs:comment "The textual content of a message." .

conversation:timestamp rdf:type owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:domain conversation:Conversation ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The timestamp indicating when the conversation took place." .

conversation:participants rdf:type owl:DatatypeProperty ;
    rdfs:label "participants" ;
    rdfs:domain conversation:Conversation ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of participants involved in the conversation." .

# Instance of the conversation
conversation:Conversation1 rdf:type conversation:Conversation ;
    conversation:hasMessage conversation:Message1, conversation:Message2, conversation:Message3, 
                          conversation:Message4, conversation:Message5, conversation:Message6 ;
    conversation:timestamp "2024-12-19T00:00:00Z"^^xsd:dateTime ;
    conversation:participants "User, Assistant" ;
    rdfs:comment "An instance of the conversation between the user and the assistant." .

conversation:Message1 rdf:type conversation:Message ;
    conversation:content """In ontologies, particularly Turtle, languages are represented using a graph-based structure that allows defining rich relationships between concepts.""" .

conversation:Message2 rdf:type conversation:Message ;
    conversation:content """Sure! Turtle is one format for expressing RDF (Resource Description Framework) data, which is useful for representing semantic web information.""" .

conversation:Message3 rdf:type conversation:Message ;
    conversation:content """Exactly! Since the underlying data model is the same, you can convert between these formats without losing any semantic information.""" .

conversation:Message4 rdf:type conversation:Message ;
    conversation:content """No, they don't. The conventions for increasing readability in Turtle, like using prefixes, indentation, and comments, don't affect the underlying data.""" .

conversation:Message5 rdf:type conversation:Message ;
    conversation:content "Let me know what specific concepts or relationships you'd like included in the ontology." .

conversation:Message6 rdf:type conversation:Message ;
    conversation:content """Include our dialog from the beginning in the instance specification, including the explanations of ontologies and different modeling capabilities.""" .
