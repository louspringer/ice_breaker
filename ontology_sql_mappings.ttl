@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conv: <./conversation#> .
@prefix map: <./ontology_sql_mappings#> .
@prefix icebreaker: <./icebreaker#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

# Mapping Ontology
map:SQLMappingOntology rdf:type owl:Ontology ;
    dc:title "SQL Mapping Ontology" ;
    dc:version "1.0" ;
    owl:imports <./meta>, <./metameta> ;
    rdfs:comment "Defines mappings between ontology entities and SQL schema objects" .

# Core Classes
map:SQLMapping rdf:type owl:Class ;
    rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "SQL Mapping" ;
    rdfs:comment "Defines mappings between ontology elements and SQL database structures" .

map:TableMapping rdfs:subClassOf map:SQLMapping ;
    rdfs:label "Table Mapping" ;
    rdfs:comment "Maps an ontology class to a SQL table" .

map:ColumnMapping rdfs:subClassOf map:SQLMapping ;
    rdfs:label "Column Mapping" ;
    rdfs:comment "Maps an ontology property to a SQL column" .

# Snowflake Base Classes
map:SnowflakeObject rdf:type owl:Class ;
    rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Snowflake Object" ;
    rdfs:comment "Base class for Snowflake database objects" .

map:SnowflakeSecurityObject rdfs:subClassOf map:SnowflakeObject ;
    rdfs:label "Snowflake Security Object" ;
    rdfs:comment "Base class for Snowflake security-related objects" .

# Snowflake-specific Classes
map:SnowflakeRole rdfs:subClassOf map:SnowflakeSecurityObject ;
    rdfs:label "Snowflake Role" ;
    rdfs:comment "Represents a Snowflake security role" .

map:SnowflakeGrant rdfs:subClassOf map:SnowflakeSecurityObject ;
    rdfs:label "Snowflake Grant" ;
    rdfs:comment "Represents a privilege grant in Snowflake" .

map:SnowflakeSchema rdfs:subClassOf map:SnowflakeObject ;
    rdfs:label "Snowflake Schema" ;
    rdfs:comment "Represents a Snowflake schema container" .

map:SnowflakeConstraint rdfs:subClassOf map:SnowflakeObject ;
    rdfs:label "Snowflake Constraint" ;
    rdfs:comment "Represents a constraint in Snowflake" .

# Validation Classes
map:ValidationResult rdf:type owl:Class ;
    rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Validation Result" ;
    rdfs:comment "Result of validating SQL mappings" .

map:IdempotencyRule rdf:type owl:Class ;
    rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Idempotency Rule" ;
    rdfs:comment "Rule ensuring idempotent SQL operations" .

# Properties
map:hasTableName rdf:type owl:DatatypeProperty ;
    rdfs:label "has table name" ;
    rdfs:domain map:SQLMapping ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the SQL table name for an ontology element" ;
    metameta:modeledBy metameta:ModelingConstruct .

map:hasColumnName rdf:type owl:DatatypeProperty ;
    rdfs:label "has column name" ;
    rdfs:domain map:SQLMapping ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the SQL column name for an ontology property" ;
    metameta:modeledBy metameta:ModelingConstruct .

map:hasDataType rdf:type owl:DatatypeProperty ;
    rdfs:label "has SQL data type" ;
    rdfs:domain map:SQLMapping ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the SQL data type for a property" ;
    metameta:modeledBy metameta:ModelingConstruct . 