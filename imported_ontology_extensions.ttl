@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix prob: <./problem#> .
@prefix sol: <./solution#> .
@prefix conv: <./conversation#> .
@prefix map: <./map#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

map:OntologyExtensions rdf:type owl:Ontology ;
    dc:title "Ontology Extensions" ;
    dc:version "1.0" ;
    owl:imports <./meta>, <./metameta>, <./problem>, <./solution>, <./conversation> ;
    rdfs:comment "Extensions and customizations of imported ontologies" .

# MetaMeta Extensions
metameta:AbstractionDimension rdfs:subClassOf owl:Thing ;
    rdfs:label "Abstraction Dimension" ;
    rdfs:comment "Dimension along which abstraction can occur" ;
    metameta:modeledBy metameta:ModelingConstruct .

metameta:AbstractionLevel rdfs:subClassOf metameta:AbstractionDimension ;
    rdfs:label "Abstraction Level" ;
    rdfs:comment "A specific level of abstraction" ;
    metameta:modeledBy metameta:ModelingConstruct .

metameta:KnowledgeDomain rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Knowledge Domain" ;
    rdfs:comment "A specific domain of knowledge" .

# Problem Extensions
prob:Context rdfs:subClassOf meta:Context ;
    rdfs:label "Problem Context" ;
    rdfs:comment "Context in which a problem exists" ;
    metameta:modeledBy metameta:ModelingConstruct .

prob:Constraint rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Problem Constraint" ;
    rdfs:comment "A constraint on problem solutions" .

# Solution Extensions
sol:Implementation rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Solution Implementation" ;
    rdfs:comment "Implementation of a solution" .

sol:Validation rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Solution Validation" ;
    rdfs:comment "Validation of a solution" .

# Conversation Extensions
conv:Conversation rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "Conversation" ;
    rdfs:comment "A conversation between participants" .

conv:Message rdfs:subClassOf conv:Conversation ;
    rdfs:label "Message" ;
    rdfs:comment "A message within a conversation" .

# SQL Mapping Extensions
map:SQLMapping rdfs:subClassOf metameta:ModelingConstruct ;
    rdfs:label "SQL Mapping" ;
    rdfs:comment "Mapping between ontology and SQL schema" ;
    metameta:modeledBy metameta:ModelingConstruct .

# Add validation rules
map:SQLMapping rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty metameta:hasBaseCase ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] . 